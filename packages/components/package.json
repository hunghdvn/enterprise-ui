{
  "name": "@enterprise-ui/components",
  "version": "0.1.0",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./style.css": "./dist/style.css"
  },
  "files": [
    "dist",
    "THIRD_PARTY_NOTICES.md"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/hunghdvn/enterprise-ui.git",
    "directory": "packages/components"
  },
  "homepage": "https://github.com/hunghdvn/enterprise-ui/tree/main/packages/components",
  "peerDependencies": {
    "react": "^18.3.0",
    "react-dom": "^18.3.0"
  },
  "dependencies": {
    "@enterprise-ui/tokens": "*"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^6.4.0",
    "@testing-library/react": "^16.0.0",
    "@types/react": "^18.3.0",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.0",
    "jsdom": "^24.0.0",
    "lucide-static": "0.545.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "typescript": "^5.0.0",
    "vite": "^5.4.0",
    "vite-node": "2.1.9",
    "vitest": "^2.0.0"
  },
  "scripts": {
    "test": "node scripts/gen-icon-types.mjs --check && node scripts/check-icon-provenance.mjs && vitest run",
    "typecheck": "tsc --noEmit",
    "gen:icon-types": "node scripts/gen-icon-types.mjs",
    "gen:icon-manifest": "vite-node scripts/gen-icon-manifest.ts",
    "build": "vite build && tsc -p tsconfig.build.json && node scripts/check-bundle-size.mjs"
  }
