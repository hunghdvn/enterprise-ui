{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "noEmit": true,
    /* Component source must not see test or node globals; tsconfig.test.json adds them. */
    "types": []
  },
  "include": [
    "src",
    "scripts/geometry-hash.ts",
    "vitest.config.ts",
    "vitest.setup.ts",
    "vite.config.ts"
  ],
  /* Component source must not see node globals; tests get them from tsconfig.test.json. */
  "exclude": ["src/**/*.test.ts", "src/**/*.test.tsx"]
}
