{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "noEmit": true,
    "types": ["vitest/globals"]
  },
  "include": ["src", "vitest.config.ts", "vitest.setup.ts", "vite.config.ts"],
  /* Component source must not see node globals; tests get them from tsconfig.test.json. */
  "exclude": ["src/**/*.test.ts", "src/**/*.test.tsx"]
}
